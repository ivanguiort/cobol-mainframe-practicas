//SORTIF JOB 1,NOTIFY=&SYSUID
//*****************************************************
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE USUARIO.ACEPTADO
  DELETE USUARIO.ORDENADO
  DELETE USUARIO.RECHAZO
  SET MAXCC=0
/*
//COMPSUB  EXEC IGYWCL
//COBOL.SYSLIB DD DSN=&SYSUID..COPY,DISP=SHR
//COBOL.SYSIN  DD DSN=&SYSUID..CBL(BUSCACAT),DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(BUSCACAT),DISP=SHR
//***************************************************/
//COMPMAIN EXEC IGYWCL,PARM.COBOL='DYNAM'
//COBOL.SYSLIB DD DSN=&SYSUID..COPY,DISP=SHR
//COBOL.SYSIN  DD DSN=&SYSUID..CBL(TABCOPY),DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(TABCOPY),DISP=SHR
//***************************************************/
//RUN     EXEC PGM=TABCOPY
//STEPLIB   DD DSN=&SYSUID..LOAD,DISP=SHR
//ENTRADA   DD DSN=&SYSUID..REGI,DISP=SHR
//ACEPTA    DD DSN=&SYSUID..ACEPTADO,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(1,1)),
//             DCB=(RECFM=FB,LRECL=30,BLKSIZE=0)
//RECHAZA     DD DSN=&SYSUID..RECHAZO,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(1,1)),
//             DCB=(RECFM=FB,LRECL=30,BLKSIZE=0)
//SYSOUT    DD SYSOUT=*
//***************************************************/
// IF (RUN.RC=0) THEN
//ORDENAR EXEC PGM=SORT,REGION=0M
//SYSOUT  DD SYSOUT=*
//SORTIN  DD DSN=&SYSUID..ACEPTADO,DISP=SHR
//SORTOUT DD DSN=&SYSUID..ORDENADO,
//           DISP=(NEW,CATLG,DELETE),
//           SPACE=(TRK,(1,1)),
//           DCB=(RECFM=FB,LRECL=30,BLKSIZE=0)
//SYSIN   DD *
    INCLUDE COND=(1,2,CH,EQ,C'AL',OR,1,2,CH,EQ,C'BE')
    SORT FIELDS=(1,6,CH,A)
/*
// ENDIF
