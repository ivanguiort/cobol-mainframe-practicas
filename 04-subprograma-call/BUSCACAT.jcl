//BUSCACAT JOB 1,NOTIFY=&SYSUID
//*****************************************************
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE USUARIO.ACEPTADO
  DELETE USUARIO.RECHAZO
  SET MAXCC=0
